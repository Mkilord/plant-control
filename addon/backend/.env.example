# Скопируй в .env и заполни. Файл .env в git не попадает.
# Адрес Home Assistant и долгоживущий токен (Профиль, Безопасность, Долгоживущие токены доступа).
PLANT_CONTROL_HA_URL=http://homeassistant.local:8123
PLANT_CONTROL_HA_TOKEN=
# Порт веб-сервера add-on'а.
PLANT_CONTROL_PORT=8099
# Собранный фронт (npm run build в addon/frontend). Без него работает только API.
PLANT_CONTROL_STATIC_DIR=../frontend/dist
